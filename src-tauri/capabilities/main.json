{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main window. Grants only the app's own commands, listening to the app's events and no plugin permissions (no fs, http or shell), see spec §14.3.",
  "windows": ["main"],
  "permissions": [
    "allow-list-surahs",
    "allow-get-surah",
    "allow-get-verses",
    "allow-list-translations",
    "allow-get-core-status",
    "allow-list-tafsirs",
    "allow-get-tafsir",
    "allow-get-tafsir-introduction",
    "allow-get-compare",
    "allow-get-morphology-pack",
    "allow-get-verse-words",
    "allow-get-word",
    "allow-concordance",
    "allow-search-roots",
    "allow-classify-query",
    "allow-search-text",
    "allow-get-settings",
    "allow-set-setting",
    "allow-set-settings",
    "allow-fetch-manifest",
    "allow-install-pack",
    "allow-install-bundle",
    "allow-cancel-install",
    "allow-uninstall-pack",
    "allow-vacuum-content",
    "allow-acknowledge-pack-terms",
    "allow-get-network-log",
    "allow-open-pack-source",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}

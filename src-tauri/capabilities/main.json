{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main window. Grants only the app's own commands and no plugin permissions (no fs, http or shell), see spec §14.3.",
  "windows": ["main"],
  "permissions": [
    "allow-list-surahs",
    "allow-get-surah",
    "allow-get-verses",
    "allow-list-translations",
    "allow-get-core-status",
    "allow-get-settings",
    "allow-set-setting",
    "allow-set-settings"
  ]
}

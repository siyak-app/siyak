    "allow-search-text",
    "allow-get-semantic-status",
    "allow-search-meaning",
    "allow-related-by-meaning",
    "allow-related-by-roots",
    "allow-get-api-keys",
    "allow-set-api-key",
    "allow-delete-api-key",
    "allow-get-ai-status",
    "allow-list-models",
    "allow-cancel-generation",
    "allow-get-usage-summary",

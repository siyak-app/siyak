# APA (7th edition), reference style.
# Fields are written {name}; a [ ] section is dropped if a field inside it is missing.
name = APA
quran = The Qur'an {surah}:{ayah}.
translation = [{author}. ][({year}). ]{title}.[ {publisher}.] {surah_en} {surah}:{ayah}.
tafsir = [{author}. ][({year}). ]{title}.[ {editor} (Ed.).][ {publisher}.][ {locator}.]
bibliography = [{author}. ][({year}). ]{title}.[ {editor} (Ed.).][ {publisher}.][ {url}]
